<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>دردشة فورية - Chat App</title>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f0f2f5; margin: 0; padding: 20px; display: flex; justify-content: center; }
    .chat-container { width: 100%; max-width: 500px; background: white; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); overflow: hidden; display: flex; flex-direction: column; height: 80vh; }
    .header { background: #0084ff; color: white; padding: 15px; text-align: center; font-size: 18px; font-weight: bold; }
    .messages { flex: 1; padding: 15px; overflow-y: auto; background: #e5e5e5; }
    .message { margin-bottom: 15px; display: flex; flex-direction: column; }
    .message .name { font-size: 12px; color: #666; margin-bottom: 4px; }
    .message .text { background: white; padding: 10px 15px; border-radius: 15px; display: inline-block; max-width: 80%; box-shadow: 0 1px 2px rgba(0,0,0,0.1); }
    .message.mine { align-items: flex-end; }
    .message.mine .text { background: #dcf8c6; }
    .input-area { display: flex; padding: 10px; background: white; border-top: 1px solid #ccc; }
    .input-area input { flex: 1; padding: 10px; border: 1px solid #ccc; border-radius: 20px; outline: none; margin-left: 10px; }
    .input-area button { background: #0084ff; color: white; border: none; padding: 10px 20px; border-radius: 20px; cursor: pointer; font-weight: bold; }
    .input-area button:hover { background: #006bce; }
  </style>
</head>
<body>

  <div class="chat-container">
    <div class="header">غرفة الدردشة</div>
    
    <!-- هنا ستظهر الرسائل -->
    <div class="messages" id="messagesDiv"></div>
    
    <!-- مكان كتابة الرسالة -->
    <div class="input-area">
      <input type="text" id="nameInput" placeholder="اسمك..." style="max-width: 100px; margin-left: 5px;">
      <input type="text" id="msgInput" placeholder="اكتب رسالتك هنا..." onkeypress="handleEnter(event)">
      <button onclick="sendMessage()">إرسال</button>
    </div>
  </div>

  <!-- كود Firebase -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
    import { getDatabase, ref, push, onChildAdded, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

    // إعدادات Firebase (مأخوذة من حسابك)
    const firebaseConfig = {
      apiKey: "AIzaSyCGxjWSdyrPUpPKbXieSap...", // الكود الذي يظهر في صورتك
      authDomain: "chat-app-8df58.firebaseapp.com",
      databaseURL: "https://chat-app-8df58-default-rtdb.asia-southeast1.firebasedatabase.app",
      projectId: "chat-app-8df58",
      storageBucket: "chat-app-8df58.appspot.com",
      messagingSenderId: "123456789", 
      appId: "1:123456789:web:abcdef"
    };

    // تشغيل Firebase
    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);
    const messagesRef = ref(db, 'messages');

    const messagesDiv = document.getElementById('messagesDiv');
    let myId = "user_" + Math.floor(Math.random() * 1000); // معرف عشوائي بسيط لكل مستخدم

    // 1. الاستماع للرسائل الجديدة فوراً
    onChildAdded(messagesRef, (snapshot) => {
      const msg = snapshot.val();
      
      const msgDiv = document.createElement('div');
      // التحقق مما إذا كانت الرسالة من نفس المستخدم
      msgDiv.className = msg.userId === myId ? 'message mine' : 'message';
      
      msgDiv.innerHTML = `
        <span class="name">${msg.name}</span>
        <span class="text">${msg.text}</span>
      `;
      
      messagesDiv.appendChild(msgDiv);
      messagesDiv.scrollTop = messagesDiv.scrollHeight; // التمرير للأسفل تلقائياً
    });

    // 2. دالة إرسال الرسالة
    window.sendMessage = function() {
      const name = document.getElementById('nameInput').value.trim() || 'مجهول';
      const text = document.getElementById('msgInput').value.trim();
      
      if (!text) return; // لا ترسل رسالة فارغة

      // إضافة الرسالة لقاعدة البيانات
      push(messagesRef, {
        name: name,
        text: text,
        userId: myId,
        timestamp: serverTimestamp()
      });

      document.getElementById('msgInput').value = ''; // تفريغ الخانة
    };

    // إرسال عند الضغط على Enter
    window.handleEnter = function(event) {
      if (event.key === 'Enter') {
        sendMessage();
      }
    };
  </script>
</body>
</html>
